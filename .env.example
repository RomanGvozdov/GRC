# Скопіюйте в .env та заповніть перед першим запуском

# Пароль БД PostgreSQL (довільний надійний рядок)
POSTGRES_PASSWORD=

# Ключ підпису JWT та шифрування TOTP-секретів.
# Згенеруйте: openssl rand -hex 32
SECRET_KEY=

# Перший адміністратор (створюється один раз, коли БД порожня)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
ADMIN_FULL_NAME=Адміністратор

# Порт, на якому буде доступний веб-інтерфейс
HTTP_PORT=80

# --- Сповіщення (опційно; email вимкнені, поки не задано SMTP_HOST) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=grc@company.ua
# Посилання в листах на систему
BASE_URL=
# Slack incoming webhook та/або Telegram-бот для дайджесту в канал
SLACK_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Година щоденного дайджесту прострочень (Europe/Kyiv)
DIGEST_HOUR=8

# --- AI (опційно; ТЗ §9, вимкнено за замовчуванням) ---
# У КСЗІ-режимі — лише локальна модель (Ollama/vLLM), дані не покидають периметр.
AI_ENABLED=false
AI_PROVIDER=openai_compat
# Якщо запускаєте вбудований сервіс ollama (профіль "ai") — лишайте порожнім,
# backend за замовчуванням ходить на http://ollama:11434/v1.
# Для зовнішнього LLM-сервера вкажіть його OpenAI-сумісний URL.
AI_BASE_URL=
AI_MODEL=qwen2.5:7b
AI_EMBED_MODEL=bge-m3
AI_API_KEY=
AI_EMBED_DIM=1024

# --- SIEM Wazuh (опційно; аналіз подій за період, доказ AU-6) ---
# Рекомендовано окремі read-only облікові записи API та indexer.
WAZUH_ENABLED=false
# Менеджер Wazuh (JWT-автентифікація), напр. https://wazuh.local:55000
WAZUH_API_URL=
WAZUH_API_USER=
WAZUH_API_PASSWORD=
# Indexer/OpenSearch — тут зберігаються події, напр. https://wazuh.local:9200
WAZUH_INDEXER_URL=
WAZUH_INDEXER_USER=
WAZUH_INDEXER_PASSWORD=
# TLS: у Wazuh типово самопідписані сертифікати — вкажіть CA-файл (змонтуйте в
# контейнер) або, лише для ізольованого сегмента, WAZUH_VERIFY_SSL=false
WAZUH_VERIFY_SSL=true
WAZUH_CA_BUNDLE=
